# Local configuration may contain real upstream API keys. Only the example
# template is committed; a deployment's own gateway.yaml must never be.
gateway.yaml
gateway.yml
gateway.json
*.local.yaml
*.local.yml

# Secrets in any form.
.env
.env.*
!.env.example
*.pem
*.key
credentials*.yaml
.credentials.yaml

# Built binaries.
#
# Leading slashes matter: a bare "mockupstream" would also match the
# tools/mockupstream/ source directory at any depth and silently exclude it
# from the repository. Anchor every rule to the repository root.
/llmgateway
/llmgateway.exe
/mockupstream
/mockupstream.exe
/ssestream
/ssestream.exe
/verifye2e
/verifye2e.exe
/seeddemo
/seeddemo.exe

# Local run logs.
*.log
*.err

# OS / editor noise.
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*~
